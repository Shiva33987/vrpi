# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Security & Tokens
JWT_ACCESS_SECRET=replace-with-a-very-long-secret-key-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-very-long-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrpi_hrms?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrpi_hrms_test?schema=public

# Client URLs (for CORS)
WEB_APP_URL=http://localhost:5173
MOBILE_APP_URL=http://localhost:8081

# Organization Defaults
DEFAULT_ORG_TIMEZONE=Asia/Kolkata
DEFAULT_ORG_CURRENCY=INR

# File Upload Storage
STORAGE_LOCAL_DIR=./storage/uploads
MAX_FILE_SIZE_MB=5
